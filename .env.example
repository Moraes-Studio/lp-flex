# ── Público (visível no navegador) ──
# Domínio canônico é a versão COM www (SEO, rodada final) — confirmar que o
# valor real configurado na Vercel bate com isto; metadataBase/canonical são
# derivados direto desta variável.
NEXT_PUBLIC_SITE_URL=https://www.academiaflex.com.br
# Confirmado pelo cliente em 2026-08-18
NEXT_PUBLIC_WHATSAPP_NUMBER=5511939182762
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/academiaflex/
# Código de verificação de domínio do Meta Business Manager (Configurações da
# Empresa → Segurança da marca → Domínios). Opcional — só preencher quando o
# domínio real for cadastrado lá; sem isso a tag não é renderizada.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# ── Servidor (nunca prefixo NEXT_PUBLIC_, nunca no bundle do cliente) ──
# Next Fit — API só-leitura (SDD.md §6)
NEXTFIT_API_KEY=

# Gateway de pagamento — Rede ou Cielo, decisão pendente do cliente (SDD.md §8)
PAYMENT_GATEWAY_CLIENT_SECRET=
